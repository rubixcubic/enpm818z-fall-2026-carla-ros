<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>l9_planning_demo</name>
  <version>1.0.0</version>
  <description>
    ENPM818Z Lecture 9 demonstration: the lecture's sampling planner on Town03 in
    CARLA, with every candidate path drawn in RViz.
  </description>
  <maintainer email="zeidk@umd.edu">Zeid Kootbally</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- The CARLA Python API is NOT a ROS package. Install it into the same
       interpreter with: pip install carla==0.9.16 -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
